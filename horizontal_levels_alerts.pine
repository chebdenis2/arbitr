//@version=5
indicator("Horizontal Levels @ 1 (+/- %), with Alerts", overlay=true, max_lines_count=50, max_labels_count=50)

// Центральный уровень ВСЕГДА 1.0 (для графика спреда/ratio).
const float baseLevel = 1.0

// Настройки отклонений
upperPct = input.float(3.0, "Отклонение вверх, %", minval=0.0, step=0.1)
lowerPct = input.float(3.0, "Отклонение вниз, %", minval=0.0, step=0.1)
lowerCalcMode = input.string("Reciprocal (1/(1+%))", "Как считать нижний уровень", options=["Linear (1-% )", "Reciprocal (1/(1+%))"])

// Как считать срабатывание алерта
alertMode = input.string("Touch (wick)", "Режим алерта", options=["Touch (wick)", "Cross (close)"])

showLabels = input.bool(true, "Показывать подписи уровней (справа)")

upperLevel = baseLevel * (1.0 + upperPct / 100.0)
lowerLevel = lowerCalcMode == "Linear (1-% )" ? baseLevel * (1.0 - lowerPct / 100.0) : baseLevel / (1.0 + lowerPct / 100.0)

// Линии через line.* (на спред/формулах часто надёжнее, чем hline)
var line lnBase = na
var line lnUp = na
var line lnDn = na

if barstate.isfirst
    lnBase := line.new(bar_index, baseLevel, bar_index + 1, baseLevel, extend=extend.both, color=color.white, width=2)
    lnUp   := line.new(bar_index, upperLevel, bar_index + 1, upperLevel, extend=extend.both, color=color.lime, width=1, style=line.style_dotted)
    lnDn   := line.new(bar_index, lowerLevel, bar_index + 1, lowerLevel, extend=extend.both, color=color.red, width=1, style=line.style_dotted)
else
    line.set_y1(lnBase, baseLevel), line.set_y2(lnBase, baseLevel)
    line.set_y1(lnUp, upperLevel),  line.set_y2(lnUp, upperLevel)
    line.set_y1(lnDn, lowerLevel),  line.set_y2(lnDn, lowerLevel)

// Подписи справа (обновляются на последнем баре)
var label lblBase = na
var label lblUp = na
var label lblDn = na

if barstate.islast
    if showLabels
        label.delete(lblBase)
        label.delete(lblUp)
        label.delete(lblDn)
        lblBase := label.new(bar_index, baseLevel, "1.0000 (BASE)", style=label.style_label_left, textcolor=color.black, color=color.white)
        lblUp   := label.new(bar_index, upperLevel, str.format("+{0}%  ({1})", upperPct, str.tostring(upperLevel, format.mintick)), style=label.style_label_left, textcolor=color.black, color=color.lime)
        lblDn   := label.new(bar_index, lowerLevel, str.format("-{0}%  ({1})", lowerPct, str.tostring(lowerLevel, format.mintick)), style=label.style_label_left, textcolor=color.white, color=color.red)
    else
        label.delete(lblBase)
        label.delete(lblUp)
        label.delete(lblDn)

// Условия алертов
touch(float lvl) =>
    high >= lvl and low <= lvl

crossUp(float lvl) =>
    ta.crossover(close, lvl)

crossDown(float lvl) =>
    ta.crossunder(close, lvl)

baseHit  = alertMode == "Touch (wick)" ? touch(baseLevel)  : (crossUp(baseLevel)  or crossDown(baseLevel))
upperHit = alertMode == "Touch (wick)" ? touch(upperLevel) : (crossUp(upperLevel) or crossDown(upperLevel))
lowerHit = alertMode == "Touch (wick)" ? touch(lowerLevel) : (crossUp(lowerLevel) or crossDown(lowerLevel))

// Отдельные условия (удобнее для разных алертов)
alertcondition(baseHit,  "Base level hit (1.0)",  "Price hit base level 1.0")
alertcondition(upperHit, "Upper level hit (+%)",  "Price hit upper level (+%)")
alertcondition(lowerHit, "Lower level hit (-%)",  "Price hit lower level (-%)")

// Если нужно разделять направление при режиме Cross (close)
alertcondition(alertMode == "Cross (close)" and crossUp(upperLevel),   "Cross UP upper (+%)",  "Close crossed UP upper (+%)")
alertcondition(alertMode == "Cross (close)" and crossDown(upperLevel), "Cross DOWN upper (+%)","Close crossed DOWN upper (+%)")
alertcondition(alertMode == "Cross (close)" and crossUp(lowerLevel),   "Cross UP lower (-%)",  "Close crossed UP lower (-%)")
alertcondition(alertMode == "Cross (close)" and crossDown(lowerLevel), "Cross DOWN lower (-%)","Close crossed DOWN lower (-%)")
