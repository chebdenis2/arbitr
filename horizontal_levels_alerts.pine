//@version=5
// ВАЖНО (TradingView): если на графике включено "Scale price chart only" или индикаторы на отдельной шкале,
// линии могут визуально "не совпадать" с правой шкалой символа. Решение: на правой шкале → ПКМ → Merge scales
// (или отключить Chart settings → Scales → Scale price chart only).
indicator("Horizontal Levels @ 1 (+/- %), with Alerts", overlay=true, scale=scale.right, max_lines_count=50, max_labels_count=50)

// Центральный уровень ВСЕГДА 1.0 (для графика спреда/ratio).
const float baseLevel = 1.0

// Настройки отклонений
upperPct = input.float(3.0, "Отклонение вверх, %", minval=0.0, step=0.1)
lowerPct = input.float(3.0, "Отклонение вниз, %", minval=0.0, step=0.1)

// Как считать срабатывание алерта
alertMode = input.string("Touch (wick)", "Режим алерта", options=["Touch (wick)", "Cross (close)"])

showLabels = input.bool(false, "Показывать подписи уровней (справа)")
showScaleMarkers = input.bool(true, "Метки на шкале (для привязки шкалы)")

upperLevel = baseLevel * (1.0 + upperPct / 100.0)
lowerLevel = baseLevel * (1.0 - lowerPct / 100.0)

// Рисуем уровни как series через plot
plot(baseLevel,  title="BASE (1.0)",  color=color.white, linewidth=2, style=plot.style_line, trackprice=showScaleMarkers)
plot(upperLevel, title="UPPER (+%)",  color=color.lime,  linewidth=1, style=plot.style_line, trackprice=showScaleMarkers)
plot(lowerLevel, title="LOWER (-%)",  color=color.red,   linewidth=1, style=plot.style_line, trackprice=showScaleMarkers)

// Подписи справа (обновляются на последнем баре)
var label lblBase = na
var label lblUp = na
var label lblDn = na

if barstate.islast
    if showLabels
        label.delete(lblBase)
        label.delete(lblUp)
        label.delete(lblDn)
        lblBase := label.new(bar_index, baseLevel, str.format("{0} (BASE)", str.tostring(baseLevel, format.mintick)), style=label.style_label_left, textcolor=color.black, color=color.white, yloc=yloc.price)
        lblUp   := label.new(bar_index, upperLevel, str.format("+{0}%  ({1})", upperPct, str.tostring(upperLevel, format.mintick)), style=label.style_label_left, textcolor=color.black, color=color.lime, yloc=yloc.price)
        lblDn   := label.new(bar_index, lowerLevel, str.format("-{0}%  ({1})", lowerPct, str.tostring(lowerLevel, format.mintick)), style=label.style_label_left, textcolor=color.white, color=color.red, yloc=yloc.price)
    else
        label.delete(lblBase)
        label.delete(lblUp)
        label.delete(lblDn)

// Условия алертов
touch(float lvl) =>
    high >= lvl and low <= lvl

crossUp(float lvl) =>
    ta.crossover(close, lvl)

crossDown(float lvl) =>
    ta.crossunder(close, lvl)

baseHit  = alertMode == "Touch (wick)" ? touch(baseLevel)  : (crossUp(baseLevel)  or crossDown(baseLevel))
upperHit = alertMode == "Touch (wick)" ? touch(upperLevel) : (crossUp(upperLevel) or crossDown(upperLevel))
lowerHit = alertMode == "Touch (wick)" ? touch(lowerLevel) : (crossUp(lowerLevel) or crossDown(lowerLevel))

// Отдельные условия (удобнее для разных алертов)
alertcondition(baseHit,  "Base level hit (1.0)",  "Price hit base level 1.0")
alertcondition(upperHit, "Upper level hit (+%)",  "Price hit upper level (+%)")
alertcondition(lowerHit, "Lower level hit (-%)",  "Price hit lower level (-%)")

// Если нужно разделять направление при режиме Cross (close)
alertcondition(alertMode == "Cross (close)" and crossUp(upperLevel),   "Cross UP upper (+%)",  "Close crossed UP upper (+%)")
alertcondition(alertMode == "Cross (close)" and crossDown(upperLevel), "Cross DOWN upper (+%)","Close crossed DOWN upper (+%)")
alertcondition(alertMode == "Cross (close)" and crossUp(lowerLevel),   "Cross UP lower (-%)",  "Close crossed UP lower (-%)")
alertcondition(alertMode == "Cross (close)" and crossDown(lowerLevel), "Cross DOWN lower (-%)","Close crossed DOWN lower (-%)")
